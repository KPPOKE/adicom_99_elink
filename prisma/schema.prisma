generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum RoleName {
  admin
  staff
}

enum PaymentMethod {
  Cash
  Transfer
  QRIS
  Ewallet
}

enum ServiceStatus {
  Masuk
  Dicek
  Menunggu_Konfirmasi
  Diproses
  Selesai
  Diambil
  Batal
}

enum FinanceType {
  income
  expense
}

enum DigitalStatus {
  Berhasil
  Pending
  Gagal
}

enum TransactionStatus {
  Berhasil
  Pending
  Batal
}

enum PaymentStatus {
  unpaid
  paid
}

enum BankTransferStatus {
  Pending
  Berhasil
  Gagal
}

enum BankTransferKind {
  Transfer
  Tarik_Tunai
  Jasa_Transfer
  Fee_Brilink
  Mode_Pulsa
  Pembayaran_Digital
  Operasional
}

enum FundAccountType {
  Cash
  Bank
  Ewallet
  Pulsa_Server
  Other
}

enum FundMutationType {
  Opening
  Transfer_Out
  Transfer_In
  Cash_Out
  Cash_In
  Deposit_In
  Withdraw_Out
  Move_In
  Move_Out
  Adjustment
  Reversal
}

enum OperationalBearer {
  Pengirim
  Penerima
  Tidak_Ada
}

enum ReceivableStatus {
  Belum_Lunas
  Lunas
}

enum PayrollStatus {
  Pending
  Dibayar
}

model Role {
  id        Int      @id @default(autoincrement())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Outlet {
  id                   Int                   @id @default(autoincrement())
  code                 String                @unique
  name                 String
  address              String?               @db.Text
  color                String                @default("#2563EB")
  users                User[]
  customers            CustomerOutlet[]
  transactions         Transaction[]
  services             Service[]
  bankTransfers        BankTransfer[]
  bankTransferDeposits BankTransferDeposit[]
  fundAccounts         FundAccount[]
  fundMutations        FundMutation[]
  items                Item[]
  financeRecords       FinanceRecord[]
  receivables          Receivable[]
  payrolls             Payroll[]
  receiptBanks         ReceiptBankAccount[]
  receiptSetting       ReceiptSetting?
  adminFeeSetting      AdminFeeSetting?
  adminFeeRules        AdminFeeRule[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("outlets")
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  passwordHash         String                @map("password_hash")
  isActive             Boolean               @default(true) @map("is_active")
  sessionVersion       Int                   @default(0) @map("session_version")
  roleId               Int                   @map("role_id")
  role                 Role                  @relation(fields: [roleId], references: [id])
  outletId             Int?                  @map("outlet_id")
  outlet               Outlet?               @relation(fields: [outletId], references: [id])
  transactions         Transaction[]
  services             Service[]
  bankTransfers        BankTransfer[]
  bankTransferDeposits BankTransferDeposit[]
  fundMutations        FundMutation[]
  financeRecords       FinanceRecord[]
  permissions          UserPermission[]
  receivablesCreated   Receivable[]          @relation("ReceivableCreator")
  payrolls             Payroll[]             @relation("PayrollEmployee")
  payrollsCreated      Payroll[]             @relation("PayrollCreator")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("users")
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, key])
  @@index([key])
  @@map("user_permissions")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  items       Item[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  address   String?  @db.Text
  note      String?  @db.Text
  items     Item[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("suppliers")
}

model Customer {
  id            Int              @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  address       String?          @db.Text
  outlets       CustomerOutlet[]
  transactions  Transaction[]
  services      Service[]
  bankTransfers BankTransfer[]
  receivables   Receivable[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model CustomerOutlet {
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  outletId   Int      @map("outlet_id")
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([customerId, outletId])
  @@index([outletId, customerId])
  @@map("customer_outlets")
}

model Item {
  id               Int               @id @default(autoincrement())
  namaBarang       String            @map("nama_barang")
  kodeBarang       String            @map("kode_barang")
  categoryId       Int               @map("kategori_id")
  category         Category          @relation(fields: [categoryId], references: [id])
  gambar           String?
  hargaModal       Decimal           @map("harga_modal") @db.Decimal(14, 2)
  hargaJual        Decimal           @map("harga_jual") @db.Decimal(14, 2)
  stok             Int               @default(0)
  stokMinimum      Int               @default(1) @map("stok_minimum")
  satuan           String            @default("pcs")
  supplierId       Int?              @map("supplier_id")
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  outletId         Int?              @map("outlet_id")
  outlet           Outlet?           @relation(fields: [outletId], references: [id])
  deskripsi        String?           @db.Text
  transactionItems TransactionItem[]
  serviceParts     ServicePart[]
  reservedStock    Int               @default(0) @map("reserved_stock")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([outletId, kodeBarang])
  @@index([categoryId])
  @@index([outletId])
  @@index([supplierId])
  @@index([stok])
  @@index([createdAt])
  @@map("items")
}

model Transaction {
  id             Int               @id @default(autoincrement())
  kodeTransaksi  String            @unique @map("kode_transaksi")
  tanggal        DateTime          @default(now())
  customerId     Int?              @map("customer_id")
  customer       Customer?         @relation(fields: [customerId], references: [id])
  customerName   String?           @map("customer_name")
  total          Decimal           @db.Decimal(14, 2)
  diskon         Decimal           @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal           @map("grand_total") @db.Decimal(14, 2)
  grossProfit    Decimal           @default(0) @map("gross_profit") @db.Decimal(14, 2)
  paymentMethod  PaymentMethod     @map("payment_method")
  paidAmount     Decimal           @default(0) @map("paid_amount") @db.Decimal(14, 2)
  changeAmount   Decimal           @default(0) @map("change_amount") @db.Decimal(14, 2)
  nomorTujuan    String?           @map("nomor_tujuan")
  provider       String?
  jenisProduk    String?           @map("jenis_produk")
  serialNumber   String?           @map("serial_number")
  digitalStatus  DigitalStatus?    @map("digital_status")
  status         TransactionStatus @default(Berhasil)
  userId         Int               @map("user_id")
  user           User              @relation(fields: [userId], references: [id])
  outletId       Int?              @map("outlet_id")
  outlet         Outlet?           @relation(fields: [outletId], references: [id])
  items          TransactionItem[]
  financeRecords FinanceRecord[]
  fundAccountId  Int?              @map("fund_account_id")
  fundAccount    FundAccount?      @relation(fields: [fundAccountId], references: [id])
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([userId])
  @@index([outletId])
  @@index([fundAccountId])
  @@index([createdAt])
  @@index([tanggal])
  @@index([status])
  @@index([createdAt, status])
  @@index([customerId, createdAt])
  @@index([outletId, status, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int         @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  itemId        Int         @map("item_id")
  item          Item        @relation(fields: [itemId], references: [id])
  qty           Int
  price         Decimal     @db.Decimal(14, 2)
  costPrice     Decimal     @default(0) @map("cost_price") @db.Decimal(14, 2)
  subtotal      Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([transactionId])
  @@index([itemId])
  @@map("transaction_items")
}

model Service {
  id                 Int             @id @default(autoincrement())
  kodeService        String          @unique @map("kode_service")
  customerId         Int?            @map("customer_id")
  customer           Customer?       @relation(fields: [customerId], references: [id])
  customerName       String          @map("customer_name")
  customerPhone      String?         @map("customer_phone")
  deviceType         String          @map("device_type")
  deviceBrand        String?         @map("device_brand")
  deviceModel        String?         @map("device_model")
  problemDescription String          @map("problem_description") @db.Text
  diagnosis          String?         @db.Text
  estimatedCost      Decimal         @default(0) @map("estimated_cost") @db.Decimal(14, 2)
  laborCost          Decimal         @default(0) @map("labor_cost") @db.Decimal(14, 2)
  finalCost          Decimal         @default(0) @map("final_cost") @db.Decimal(14, 2)
  grossProfit        Decimal         @default(0) @map("gross_profit") @db.Decimal(14, 2)
  status             ServiceStatus   @default(Masuk)
  paymentStatus      PaymentStatus   @default(unpaid) @map("payment_status")
  paidAt             DateTime?       @map("paid_at")
  technicianNote     String?         @map("technician_note") @db.Text
  receivedDate       DateTime        @default(now()) @map("received_date")
  completedDate      DateTime?       @map("completed_date")
  pickedUpDate       DateTime?       @map("picked_up_date")
  userId             Int             @map("user_id")
  user               User            @relation(fields: [userId], references: [id])
  outletId           Int?            @map("outlet_id")
  outlet             Outlet?         @relation(fields: [outletId], references: [id])
  financeRecords     FinanceRecord[]
  parts              ServicePart[]
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([userId])
  @@index([outletId])
  @@index([createdAt])
  @@index([receivedDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([status, paymentStatus, receivedDate])
  @@index([outletId, paymentStatus, paidAt])
  @@index([outletId, status, receivedDate])
  @@map("services")
}

model ServicePart {
  id        Int      @id @default(autoincrement())
  serviceId Int      @map("service_id")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  itemId    Int      @map("item_id")
  item      Item     @relation(fields: [itemId], references: [id])
  qty       Int
  price     Decimal  @db.Decimal(14, 2)
  subtotal  Decimal  @db.Decimal(14, 2)
  costPrice Decimal  @default(0) @map("cost_price") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([serviceId, itemId])
  @@index([itemId])
  @@map("service_parts")
}

model BankTransfer {
  id               Int                @id @default(autoincrement())
  kodeTransfer     String             @unique @map("kode_transfer")
  kind             BankTransferKind   @default(Transfer)
  transactionType  String?            @map("transaction_type")
  sourceFundId     Int?               @map("source_fund_id")
  sourceFund       FundAccount?       @relation("BankTransferSourceFund", fields: [sourceFundId], references: [id])
  targetFundId     Int?               @map("target_fund_id")
  targetFund       FundAccount?       @relation("BankTransferTargetFund", fields: [targetFundId], references: [id])
  customerId       Int?               @map("customer_id")
  customer         Customer?          @relation(fields: [customerId], references: [id])
  senderName       String?            @map("sender_name")
  senderPhone      String?            @map("sender_phone")
  destinationBank  String             @map("destination_bank")
  accountNumber    String             @map("account_number")
  accountName      String             @map("account_name")
  amount           Decimal            @db.Decimal(14, 2)
  costAmount       Decimal            @default(0) @map("cost_amount") @db.Decimal(14, 2)
  adminFee         Decimal            @default(0) @map("admin_fee") @db.Decimal(14, 2)
  adminBankFee     Decimal            @default(0) @map("admin_bank_fee") @db.Decimal(14, 2)
  externalAdminFee Decimal            @default(0) @map("external_admin_fee") @db.Decimal(14, 2)
  totalReceived    Decimal            @map("total_received") @db.Decimal(14, 2)
  status           BankTransferStatus @default(Pending)
  note             String?            @db.Text
  completedAt      DateTime?          @map("completed_at")
  userId           Int                @map("user_id")
  user             User               @relation(fields: [userId], references: [id])
  outletId         Int?               @map("outlet_id")
  outlet           Outlet?            @relation(fields: [outletId], references: [id])
  financeRecord    FinanceRecord?
  fundMutations    FundMutation[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([userId])
  @@index([outletId])
  @@index([status])
  @@index([createdAt])
  @@index([destinationBank])
  @@index([outletId, status, completedAt])
  @@map("bank_transfers")
}

model BankTransferDeposit {
  id        Int      @id @default(autoincrement())
  outletId  Int      @map("outlet_id")
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  note      String?  @db.Text
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([outletId, date])
  @@index([userId])
  @@map("bank_transfer_deposits")
}

enum AdminFeeKind {
  Tarik_Tunai
  Transfer
}

enum AdminFeeType {
  Dalam
  Luar
}

model AdminFeeSetting {
  id        Int      @id @default(autoincrement())
  outletId  Int      @unique @map("outlet_id")
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_fee_settings")
}

model AdminFeeRule {
  id          Int          @id @default(autoincrement())
  outletId    Int          @map("outlet_id")
  outlet      Outlet       @relation(fields: [outletId], references: [id])
  kind        AdminFeeKind
  nominalFrom Decimal      @map("nominal_from") @db.Decimal(14, 2)
  nominalTo   Decimal      @map("nominal_to") @db.Decimal(14, 2)
  adminAmount Decimal      @map("admin_amount") @db.Decimal(14, 2)
  adminType   AdminFeeType @map("admin_type")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([outletId, kind])
  @@map("admin_fee_rules")
}

model FundAccount {
  id              Int             @id @default(autoincrement())
  outletId        Int             @map("outlet_id")
  outlet          Outlet          @relation(fields: [outletId], references: [id])
  name            String
  type            FundAccountType
  balance         Decimal         @default(0) @db.Decimal(14, 2)
  openingBalance  Decimal         @default(0) @map("opening_balance") @db.Decimal(14, 2)
  note            String?         @db.Text
  image           String?
  isActive        Boolean         @default(true) @map("is_active")
  sourceTransfers BankTransfer[]  @relation("BankTransferSourceFund")
  targetTransfers BankTransfer[]  @relation("BankTransferTargetFund")
  mutations       FundMutation[]
  receivables     Receivable[]
  transactions    Transaction[]
  financeRecords  FinanceRecord[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([outletId, name])
  @@index([outletId, type])
  @@index([isActive])
  @@map("fund_accounts")
}

model FundMutation {
  id             Int              @id @default(autoincrement())
  outletId       Int              @map("outlet_id")
  outlet         Outlet           @relation(fields: [outletId], references: [id])
  fundAccountId  Int              @map("fund_account_id")
  fundAccount    FundAccount      @relation(fields: [fundAccountId], references: [id])
  type           FundMutationType
  amount         Decimal          @db.Decimal(14, 2)
  adminFee       Decimal          @default(0) @map("admin_fee") @db.Decimal(14, 2)
  balanceBefore  Decimal          @map("balance_before") @db.Decimal(14, 2)
  balanceAfter   Decimal          @map("balance_after") @db.Decimal(14, 2)
  referenceType  String?          @map("reference_type")
  referenceId    Int?             @map("reference_id")
  bankTransferId Int?             @map("bank_transfer_id")
  bankTransfer   BankTransfer?    @relation(fields: [bankTransferId], references: [id], onDelete: SetNull)
  note           String?          @db.Text
  userId         Int              @map("user_id")
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([outletId, createdAt])
  @@index([fundAccountId, createdAt])
  @@index([bankTransferId])
  @@index([referenceType, referenceId])
  @@map("fund_mutations")
}

model FinanceRecord {
  id             Int           @id @default(autoincrement())
  type           FinanceType
  category       String
  amount         Decimal       @db.Decimal(14, 2)
  description    String?       @db.Text
  date           DateTime      @default(now())
  referenceType  String?       @map("reference_type")
  referenceId    Int?          @map("reference_id")
  transactionId  Int?          @map("transaction_id")
  transaction    Transaction?  @relation(fields: [transactionId], references: [id])
  serviceId      Int?          @map("service_id")
  service        Service?      @relation(fields: [serviceId], references: [id])
  bankTransferId Int?          @unique @map("bank_transfer_id")
  bankTransfer   BankTransfer? @relation(fields: [bankTransferId], references: [id])
  userId         Int           @map("user_id")
  user           User          @relation(fields: [userId], references: [id])
  outletId       Int?          @map("outlet_id")
  outlet         Outlet?       @relation(fields: [outletId], references: [id])
  fundAccountId  Int?          @map("fund_account_id")
  fundAccount    FundAccount?  @relation(fields: [fundAccountId], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([outletId])
  @@index([fundAccountId])
  @@index([transactionId])
  @@index([serviceId])
  @@index([date])
  @@index([type])
  @@index([date, type])
  @@index([category])
  @@index([outletId, type, date])
  @@map("finance_records")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  userEmail String?  @map("user_email")
  outletId  Int?     @map("outlet_id")
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([outletId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([action, userEmail, createdAt])
  @@map("audit_logs")
}

model Receivable {
  id            Int              @id @default(autoincrement())
  outletId      Int              @map("outlet_id")
  outlet        Outlet           @relation(fields: [outletId], references: [id])
  customerId    Int              @map("customer_id")
  customer      Customer         @relation(fields: [customerId], references: [id])
  loanDate      DateTime         @map("loan_date")
  amount        Decimal          @db.Decimal(14, 2)
  description   String?          @db.Text
  status        ReceivableStatus @default(Belum_Lunas)
  paidAt        DateTime?        @map("paid_at")
  recordExpense Boolean          @default(false) @map("record_expense")
  sourceFundId  Int?             @map("source_fund_id")
  sourceFund    FundAccount?     @relation(fields: [sourceFundId], references: [id])
  createdById   Int              @map("created_by_id")
  createdBy     User             @relation("ReceivableCreator", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([outletId, status, loanDate])
  @@index([customerId])
  @@index([sourceFundId])
  @@map("receivables")
}

model Payroll {
  id          Int           @id @default(autoincrement())
  outletId    Int           @map("outlet_id")
  outlet      Outlet        @relation(fields: [outletId], references: [id])
  employeeId  Int           @map("employee_id")
  employee    User          @relation("PayrollEmployee", fields: [employeeId], references: [id])
  period      DateTime      @db.Date
  baseSalary  Decimal       @map("base_salary") @db.Decimal(14, 2)
  allowance   Decimal       @default(0) @db.Decimal(14, 2)
  deduction   Decimal       @default(0) @db.Decimal(14, 2)
  totalSalary Decimal       @map("total_salary") @db.Decimal(14, 2)
  paymentDate DateTime?     @map("payment_date") @db.Date
  status      PayrollStatus @default(Pending)
  note        String?       @db.Text
  createdById Int           @map("created_by_id")
  createdBy   User          @relation("PayrollCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([outletId, employeeId, period])
  @@index([outletId, status, period])
  @@map("payrolls")
}

model ReceiptBankAccount {
  id            Int      @id @default(autoincrement())
  outletId      Int      @map("outlet_id")
  outlet        Outlet   @relation(fields: [outletId], references: [id])
  bankName      String   @map("bank_name")
  accountName   String   @map("account_name")
  accountNumber String   @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([outletId, bankName, accountNumber])
  @@index([outletId, bankName])
  @@map("receipt_bank_accounts")
}

model ReceiptSetting {
  id        Int      @id @default(autoincrement())
  outletId  Int      @unique @map("outlet_id")
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  storeName String   @map("store_name")
  address   String?  @db.Text
  footer    String?  @db.Text
  logo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("receipt_settings")
}

model Setting {
  id                 Int      @id @default(autoincrement())
  storeName          String   @default("PosPintar") @map("store_name")
  logo               String?
  address            String?  @db.Text
  whatsapp           String?
  email              String?
  invoicePrefix      String   @default("INV") @map("invoice_prefix")
  invoiceFooter      String?  @map("invoice_footer") @db.Text
  defaultPrintFormat String   @default("thermal_80") @map("default_print_format")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
